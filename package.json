{
  "name": "nightlandapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "test": "NODE_ENV=test npx jest --watchAll",
    "test:ci": "NODE_ENV=test jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "format:fix": "prettier . --write",
    "format:check": "prettier . --check",
    "format:markdown:fix": "prettier \"**/*.{md,mdx,markdown}\" --write",
    "format:markdown:check": "prettier \"**/*.{md,mdx,markdown}\" --check",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:all": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:all:strict": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:all:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:ci",
    "predeploy": "pnpm format:fix && pnpm lint && pnpm typecheck && pnpm test:ci",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx,markdown,json,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
